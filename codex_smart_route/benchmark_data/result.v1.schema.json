{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AMCarotenuto/codex-smart-route/blob/main/codex_smart_route/benchmark_data/result.v1.schema.json",
  "title": "Codex Smart Route benchmark result v1",
  "type": "object",
  "required": ["schema_version", "protocol_version", "suite", "mode", "variants", "routing_inputs", "platform", "runs", "summary", "calibration", "comparison", "configuration_effect"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol_version": {"const": "1.0"},
    "mode": {"enum": ["mock", "live"]},
    "suite": {
      "type": "object",
      "required": ["id", "version", "manifest_sha256"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "variants": {"type": "array", "minItems": 3, "uniqueItems": true, "contains": {"const": "auto"}},
    "routing_inputs": {
      "type": "object",
      "required": ["policy_version", "priors_version"],
      "additionalProperties": {"type": "string"}
    },
    "platform": {
      "type": "object",
      "required": ["system", "machine", "python"],
      "properties": {
        "system": {"type": "string"},
        "machine": {"type": "string"},
        "python": {"type": "string"}
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "task_class", "language", "variant", "profile_evidence", "status", "accepted", "retry_count", "correction_count", "regression", "usage", "latency_ms", "attempts", "suitability_score", "prior"],
        "properties": {
          "task_id": {"type": "string"},
          "task_class": {"type": "string"},
          "language": {"enum": ["en", "it"]},
          "variant": {"type": "string"},
          "profile_evidence": {
            "type": "object",
            "required": ["requested", "selected", "forwarded", "confirmed"],
            "properties": {
              "requested": {"type": "string"},
              "selected": {"type": "string"},
              "forwarded": {"type": "string"},
              "confirmed": {"type": "string"}
            },
            "additionalProperties": false
          },
          "status": {"enum": ["completed", "failed", "unsupported"]},
          "accepted": {"type": ["boolean", "null"]},
          "retry_count": {"type": "integer", "minimum": 0},
          "correction_count": {"type": "integer", "minimum": 0},
          "regression": {"type": "boolean"},
          "usage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "latency_ms": {"type": "object", "required": ["runner_reported", "wall_clock"]},
          "attempts": {"type": "array"},
          "suitability_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "prior": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "summary": {"type": "object"},
    "calibration": {"type": "object"},
    "comparison": {"type": "object"},
    "configuration_effect": {"const": "none; benchmark reports are never loaded as routing configuration"}
  },
  "additionalProperties": false
}
